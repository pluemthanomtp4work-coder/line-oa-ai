# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง — ห้าม commit .env เข้า git

# ===== หน้าหลังบ้าน =====
# สุ่มยาวอย่างน้อย 24 ตัว: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# หมายเหตุ: ?key= ไม่ใช่ auth จริง มันติดไปกับ URL, referrer, log ของ proxy และประวัติเบราว์เซอร์
ADMIN_KEY=

# ===== Gemini =====
GEMINI_API_KEY=
# ดูเรตของแต่ละรุ่นในตาราง RATES ของ src/ai.js ก่อนเปลี่ยน — ค่าใช้จ่ายต่างกันได้หลายเท่า
AI_MODEL=gemini-3.1-flash-lite
USD_THB=36.5

# ===== LINE Messaging API (จาก LINE Developers Console) =====
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# LINE user id ของแอดมิน คั่นด้วย , — แถวเหล่านี้จะบล็อก/ลด/ลบจากหน้าเว็บไม่ได้ (กันล็อกตัวเอง)
LINE_ADMIN_USER_IDS=

# ===== Supabase (ที่เก็บข้อมูลทั้งหมด) =====
# ไม่ตั้งสองตัวนี้ = ระบบถอยไปเก็บข้อมูลใน RAM ซึ่งหายทุกครั้งที่รีสตาร์ต (ใช้ได้แค่ตอนลองเล่น)
SUPABASE_URL=
# service_role key เท่านั้น — มัน bypass RLS ซึ่งเป็นเหตุผลที่ทุกตารางเปิด RLS แบบไม่มี policy ได้
# ⚠️ ห้ามเอาคีย์ตัวนี้ไปไว้ฝั่ง browser หรือ commit ลง git เด็ดขาด
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=uploads

# ===== อื่นๆ =====
PORT=3000
MAX_UPLOAD_MB=8
# secret แยกสำหรับลิงก์เปิดไฟล์ (ไม่ตั้งจะใช้ ADMIN_KEY แทน)
FILE_SIGN_SECRET=
FILE_LINK_TTL_MIN=15
